PRINT_RED = "\033[31m"
PRINT_GREEN = "\033[32m"
PRINT_YELLOW = "\033[33m"
RESET = "\033[0m"

# Tabela leet expandida
LEET_MAP = {
    'a': ['@', '4'],
    'e': ['3'],
    'i': ['1', '!'],
    'o': ['0'],
    's': ['$', '5'],
    't': ['7'],
    'l': ['1'],
    'b': ['8'],
    'g': ['9']
}

@lru_cache(maxsize=256)
def get_char_mutations(char: str) -> tuple:
    """Retorna mutações de caixa e leet speak para um caractere."""
    char_lower = char.lower()
    mutations = {char_lower, char_lower.upper()}
    if char_lower in LEET_MAP:
        mutations.update(LEET_MAP[char_lower])
    return tuple(mutations)

def generate_dynamic_mutations(base_string: str):
    """Gera combinações de mutação via Produto Cartesiano de forma preguiçosa (generator)."""
    options = [get_char_mutations(c) for c in base_string]
    for combo in itertools.product(*options):
        yield "".join(combo)

def sanitize_input(text: str) -> str:
    """Remove acentuações e caracteres estranhos mantendo o núcleo alfanumérico."""
    nfkd = unicodedata.normalize('NFKD', text)
    return "".join(c for c in nfkd if not unicodedata.combining(c)).strip()

def build_affixes(ano: str):
    """Constrói listas de sufixos e prefixos comuns."""
    sufixos = ['', '123', '!', '@', '#', '123456', '2024', '2025', '2026']
    prefixos = ['', '!', '@', '#']

    if ano:
        ano = ano.strip()
        novos_sufixos = [ano, f"@{ano}", f"#{ano}"]
        if len(ano) == 4 and ano.isdigit():
            ano_curto = ano[2:]
            novos_sufixos.extend([ano_curto, f"@{ano_curto}", f"#{ano_curto}"])
        for s in novos_sufixos:
            if s not in sufixos:
                sufixos.append(s)

    return prefixos, sufixos

def run():
    parser = argparse.ArgumentParser(description="Hydra Wordlister - Gerador Otimizado de Wordlists")
    parser.add_argument("-w", "--word", help="Palavra-base para mutação (ex: joao)")
    parser.add_argument("-y", "--year", help="Ano importante (ex: 1997, 2002)")
    parser.add_argument("-o", "--output", default="wordlist_embaralhada.txt", help="Arquivo de saída")
    parser.add_argument("--anagram", action="store_true", help="Ativa modo anagrama (embaralha a ordem das letras)")
    parser.add_argument("--include-prefix", action="store_true", help="Adiciona variações com prefixos comuns (!, @, #)")
    parser.add_argument("-u", "--unique", action="store_true", default=True, help="Garante que não haverá senhas repetidas (padrão: ativado)")
    parser.add_argument("--allow-duplicates", dest="unique", action="store_false", help="Permite senhas repetidas (desativa filtro de duplicatas)")

    args = parser.parse_args()

    print(f"{PRINT_RED}{BANNER}{RESET}")

    # Entrada interativa se não fornecido via CLI
    if not args.word:
        print("Digite os caracteres ou palavra-base (ex: joao):")
        palavra = input(" -> ").strip()
    else:
        palavra = args.word

    palavra_limpa = sanitize_input(palavra).lower().replace(" ", "")
    if not palavra_limpa:
        print(f"{PRINT_RED}[!] Erro: Nenhuma palavra válida informada.{RESET}")
        sys.exit(1)

    if args.year is None:
        print("\nAno importante (ex: 1997, 2002) ou pressione Enter para pular:")
        ano = input(" -> ").strip()
    else:
        ano = args.year

    if not args.anagram and not args.word:
        print("\nDeseja EMBARALHAR as posições (Anagrama completo)?")
        print("  [1] Não - Manter a ordem original da palavra (Mais rápido e senhas mais realistas)")
        print("  [2] Sim - Gerar todos os anagramas possíveis (Pode gerar milhões de senhas)")
        opcao = input(" Escolha [1/2] (Padrão: 1): ").strip()
        modo_anagrama = (opcao == "2")
    else:
        modo_anagrama = args.anagram

    if not args.word:
        print("\nDeseja filtrar duplicatas para garantir 100% de senhas únicas?")
        print("  [1] Sim - Eliminar repetições (Recomendado)")
        print("  [2] Não - Permitir repetições (Mais rápido)")
        opcao_unique = input(" Escolha [1/2] (Padrão: 1): ").strip()
        modo_unique = (opcao_unique != "2")
    else:
        modo_unique = args.unique

    prefixos, sufixos = build_affixes(ano)
    if not args.include_prefix:
        prefixos = ['']  # Apenas sufixos por padrão para não inflar desnecessariamente

    # Determinar bases para mutação
    if modo_anagrama:
        permutacoes_unicas = list(set(itertools.permutations(palavra_limpa)))
        total_bases = len(permutacoes_unicas)
        bases = ["".join(p) for p in permutacoes_unicas]
        print(f"\n[*] Modo Anagrama: {total_bases} permutações geradas.")
    else:
        bases = [palavra_limpa]
        total_bases = 1

    # Estimativa de volume
    mutacoes_por_base = 1
    for c in palavra_limpa:
        mutacoes_por_base *= len(get_char_mutations(c))
    
    total_estimado = total_bases * mutacoes_por_base * len(sufixos) * len(prefixos)
    print(f"[*] Estimativa total de combinações (bruto): {PRINT_YELLOW}{total_estimado:,}{RESET}".replace(",", "."))
    if modo_unique:
        print(f"[*] Filtro de duplicatas: {PRINT_GREEN}ATIVADO (senhas 100% únicas){RESET}")

    # Proteção contra explosão desavisada
    if total_estimado > 500_000 and not args.word:
        confirma = input(f"{PRINT_YELLOW}[!] Atenção: mais de 500 mil senhas serão geradas. Continuar? (s/N): {RESET}").strip().lower()
        if confirma not in ('s', 'sim', 'y', 'yes'):
            print("Operação cancelada pelo usuário.")
            sys.exit(0)

    # Escolha de arquivo de saída interativo
    if not args.word:
        saida_input = input(f"\nNome do arquivo de saída (Enter para '{args.output}'): ").strip()
        arquivo_saida = saida_input if saida_input else args.output
    else:
        arquivo_saida = args.output

    # Geração em streaming com desduplicação sob demanda
    print(f"\n[*] Gerando senhas e salvando diretamente em '{arquivo_saida}'...")

    total_bruto = 0
    total_gravado = 0
    duplicadas_removidas = 0
    seen = set() if modo_unique else None

    with open(arquivo_saida, "w", encoding="utf-8", buffering=1024 * 1024) as f:
        for base in bases:
            for mutacao in generate_dynamic_mutations(base):
                for pref in prefixos:
                    for suf in sufixos:
                        senha = f"{pref}{mutacao}{suf}"
                        total_bruto += 1
                        if seen is not None:
                            if senha in seen:
                                duplicadas_removidas += 1
                                continue
                            seen.add(senha)
                        f.write(senha + "\n")
                        total_gravado += 1

    print(f"\n{PRINT_GREEN}[+] Wordlist gerada com sucesso!{RESET}")
    print(f"[+] Total de senhas gravadas (únicas): {total_gravado:,}".replace(",", "."))
    if modo_unique:
        print(f"[*] Duplicatas descartadas: {duplicadas_removidas:,}".replace(",", "."))
    tamanho_mb = os.path.getsize(arquivo_saida) / (1024 * 1024)
    print(f"[+] Tamanho do arquivo: {tamanho_mb:.2f} MB")

if __name__ == "__main__":
    run()